# Never commit a filled-in copy: .env is gitignored and kept out of Docker images.
# LLM Providers (set the one you use). Each key is billed through that provider's
# API account. A consumer chat subscription (Claude Pro/Max, Gemini Advanced, ...)
# does not include API credits; only a ChatGPT plan can replace a key (see below).
OPENAI_API_KEY=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
DASHSCOPE_CN_API_KEY=
ZHIPU_API_KEY=
ZHIPU_CN_API_KEY=
MINIMAX_API_KEY=
MINIMAX_CN_API_KEY=
OPENROUTER_API_KEY=
MISTRAL_API_KEY=
MOONSHOT_API_KEY=
GROQ_API_KEY=
NVIDIA_API_KEY=

# SEC EDGAR (US company filings, point-in-time). No key; a contact address SEC can reach you at.
#SEC_EDGAR_USER_AGENT=Your Name your@email.com

# FRED (Federal Reserve macro data). Free key: https://fred.stlouisfed.org/docs/api/api_key.html
#FRED_API_KEY=

# Alpha Vantage, only if you choose it as a data vendor (Yahoo is the keyless default).
#ALPHA_VANTAGE_API_KEY=

# TypeSafe Jev: screens StockTwits and Reddit posts for the Sentiment Analyst. Optional.
#TYPESAFE_API_KEY=
#TYPESAFE_DEFAULT_MODEL=jev-latest
#TYPESAFE_BASE_URL=https://openrouter.ai/api   # Jev through OpenRouter, with an OpenRouter key above

# Custom OpenAI-compatible endpoint (vLLM, LM Studio, llama.cpp). Local servers need no key.
#OPENAI_COMPATIBLE_API_KEY=

# AWS Bedrock (pip install ".[bedrock]"). Bearer token, or the AWS credential chain; set the region either way.
#AWS_BEARER_TOKEN_BEDROCK=
#AWS_DEFAULT_REGION=us-west-2
#AWS_PROFILE=

# ChatGPT Plus or Pro plan: no key and no API bill; runs count toward the plan's
# usage limits. Sign in once with `tradingagents login chatgpt`, then set
# TRADINGAGENTS_LLM_PROVIDER=chatgpt below.

# Remote Ollama server. Unset uses http://localhost:11434/v1.
#OLLAMA_BASE_URL=http://your-ollama-host:11434/v1

# Override these DEFAULT_CONFIG keys. Provider, models, language and round counts also skip their CLI prompt.
#TRADINGAGENTS_LLM_PROVIDER=openai
#TRADINGAGENTS_DEEP_THINK_LLM=gpt-6-sol
#TRADINGAGENTS_QUICK_THINK_LLM=gpt-6-luna
# A tier on its own provider (set its model above too); its URL only for a local or relay endpoint.
#TRADINGAGENTS_DEEP_THINK_PROVIDER=
#TRADINGAGENTS_QUICK_THINK_PROVIDER=
#TRADINGAGENTS_DEEP_THINK_BACKEND_URL=
#TRADINGAGENTS_QUICK_THINK_BACKEND_URL=
#TRADINGAGENTS_LLM_BACKEND_URL=
#TRADINGAGENTS_OUTPUT_LANGUAGE=English
#TRADINGAGENTS_MAX_DEBATE_ROUNDS=1
#TRADINGAGENTS_MAX_RISK_ROUNDS=1
#TRADINGAGENTS_MAX_TOOL_ROUNDS=20
#TRADINGAGENTS_CHECKPOINT_ENABLED=false

# Turn off the start-up note about a newer release and Tauric Research notices.
#TRADINGAGENTS_NO_UPDATE_CHECK=1

# Docker: a host folder for results, reports and the memory log (unset: the tradingagents_data volume).
#TRADINGAGENTS_DATA_DIR=./data

# Paths and alpha benchmark. Unset uses ~/.tradingagents and the regional index.
#TRADINGAGENTS_RESULTS_DIR=
#TRADINGAGENTS_CACHE_DIR=
#TRADINGAGENTS_MEMORY_LOG_PATH=
#TRADINGAGENTS_BENCHMARK_TICKER=SPY

# Lower temperature means less run-to-run variation on models that honor it.
#TRADINGAGENTS_TEMPERATURE=0.0

# Retry budget for every LLM SDK. Raise it to ride out 429 throttling.
#TRADINGAGENTS_LLM_MAX_RETRIES=6

# Cap output tokens per call, to bound a model that runs long and trips a timeout.
# Too low a cap cuts off reasoning models' answers; 4096 is the cloud profile's start.
#TRADINGAGENTS_MAX_TOKENS=4096

# Spending limits for one analysis, shared by every model call of the run and
# checked before each request and each retry (unset = no limit). Calls include
# failed requests and retries; tokens are provider-reported, estimated otherwise.
# With every limit off nothing is refused and clients are built as before.
#TRADINGAGENTS_MAX_LLM_CALLS=40
#TRADINGAGENTS_MAX_TOKENS_PER_RUN=200000
# Reflections on past decisions draw on their own allowance (unset: the same
# values as above, as a separate pool); their cost counts in the daily total.
#TRADINGAGENTS_MAX_REFLECTION_CALLS=
#TRADINGAGENTS_MAX_REFLECTION_TOKENS=
# TypeSafe screening requests per run (each attempt counts; none under a cost limit).
#TRADINGAGENTS_MAX_EXTERNAL_REQUESTS=
# Cost limits in USD are estimates from a pricing file you fill in from the
# provider's pricing page (template: deploy/cloud/pricing.example.json). They fail
# closed: with one set, a run will not start without a valid, recent file pricing
# every model in use, TRADINGAGENTS_MAX_TOKENS set, and a supported provider (not
# chatgpt, ollama, openai_compatible or bedrock) whose client targets its official
# endpoint (*_BASE_URL overrides are refused). The per-run figure covers the
# analysis and its reflections together.
# Spend is recorded per UTC day in <cache dir>/spend/ whenever prices are known.
# Set a hard limit in the provider's billing settings as well.
#TRADINGAGENTS_MAX_COST_PER_RUN=
#TRADINGAGENTS_MAX_COST_PER_DAY=
#TRADINGAGENTS_PRICING_FILE=
#TRADINGAGENTS_MAX_PRICING_AGE_DAYS=90

# Reasoning depth per provider; setting one skips its prompt.
#TRADINGAGENTS_OPENAI_REASONING_EFFORT=medium
#TRADINGAGENTS_GOOGLE_THINKING_LEVEL=high
#TRADINGAGENTS_ANTHROPIC_EFFORT=high
