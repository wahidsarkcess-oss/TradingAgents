# Settings for deploy/cloud runs. Copy to cloud.env (gitignored).
# NO SECRETS HERE: API keys go in secrets.env, which is mounted as a Docker secret.

# --- LLM provider and models (required; deliberately blank, nothing is hard-coded) ---
# Any provider TradingAgents supports, e.g. openai, anthropic, google, deepseek,
# openrouter, groq, ollama, openai_compatible, chatgpt. A run without a terminal
# stops before calling any model and names whichever of these is missing.
TRADINGAGENTS_LLM_PROVIDER=
TRADINGAGENTS_QUICK_THINK_LLM=
TRADINGAGENTS_DEEP_THINK_LLM=
# Only for a local or relay endpoint (ollama on another host, vLLM, ...):
#TRADINGAGENTS_LLM_BACKEND_URL=

# --- Analysis depth (lower = fewer calls) ---
TRADINGAGENTS_OUTPUT_LANGUAGE=English
TRADINGAGENTS_MAX_DEBATE_ROUNDS=1
TRADINGAGENTS_MAX_RISK_ROUNDS=1
TRADINGAGENTS_MAX_TOOL_ROUNDS=8
TRADINGAGENTS_CHECKPOINT_ENABLED=false

# --- Spending limits, per analysis, checked before every LLM request ---
TRADINGAGENTS_MAX_LLM_CALLS=40
TRADINGAGENTS_MAX_TOKENS=4096
TRADINGAGENTS_MAX_TOKENS_PER_RUN=200000
TRADINGAGENTS_LLM_MAX_RETRIES=2
# Reflections on past decisions have their own allowance; unset, each takes the
# value above as a separate pool. Their cost still counts in the daily total.
#TRADINGAGENTS_MAX_REFLECTION_CALLS=
#TRADINGAGENTS_MAX_REFLECTION_TOKENS=
# Cost limits (USD, estimated) fail closed: set them only together with a filled-in
# pricing file and TRADINGAGENTS_MAX_TOKENS, for a provider at its official endpoint
# (not chatgpt, ollama or openai_compatible). pricing.json in this folder is copied
# into the image at build time.
#TRADINGAGENTS_MAX_COST_PER_RUN=
#TRADINGAGENTS_MAX_COST_PER_DAY=
#TRADINGAGENTS_PRICING_FILE=/home/appuser/app/deploy/cloud/pricing.json
#TRADINGAGENTS_MAX_PRICING_AGE_DAYS=90

# --- Unattended operation ---
TRADINGAGENTS_NO_UPDATE_CHECK=1
# SEC asks for a contact it can reach about your traffic (not a key):
#SEC_EDGAR_USER_AGENT=Your Name contact@your-domain.example
