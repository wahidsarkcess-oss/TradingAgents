# API keys for deploy/cloud. Copy to secrets.env (gitignored, excluded from the
# Docker build context), then: chmod 600 secrets.env
# Mounted at /run/secrets/tradingagents.env and read by entrypoint.sh; never baked
# into the image and not visible in `docker inspect`. Set only what you use.
#
# Each key is billed by that provider's API. A Claude Pro/Max subscription does
# NOT include Anthropic API credits; ANTHROPIC_API_KEY needs an Anthropic API
# account with its own billing. The chatgpt provider needs no key here (it uses
# a `tradingagents login chatgpt` sign-in kept in the data volume).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
#XAI_API_KEY=
#MISTRAL_API_KEY=
#OPENAI_COMPATIBLE_API_KEY=

# Optional data sources
#FRED_API_KEY=
#ALPHA_VANTAGE_API_KEY=
